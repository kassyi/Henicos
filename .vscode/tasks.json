{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Tests (dotnet watch)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "--project",
        "tests/Kassyi.GSharp.Tests/Kassyi.GSharp.Tests.csproj",
        "test",
        "--verbosity",
        "minimal"
      ],
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*(?:dotnet watch|Building|File changed|Hot reload).*$",
          "endsPattern": "^\\s*(?:Waiting for a file change|dotnet watch|Passed!|Failed!).*$"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "watchers",
        "clear": true
      }
    }
  ]
}
