{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Tests (watchexec)",
      "type": "shell",
      "command": "watchexec",
      "args": [
        "--debounce",
        "3s",
        "-w",
        "src",
        "-w",
        "tests",
        "-e",
        "cs,csproj",
        "--restart",
        "--clear",
        "--",
        "just",
        "test"
      ],
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*(?:Microsoft \\(R\\) Build Engine|Determining projects to restore|Building|Restored|watchexec).*$",
          "endsPattern": "^\\s*(?:Passed!|Failed!).*$"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "watchers",
        "clear": true
      }
    }
  ]
}
