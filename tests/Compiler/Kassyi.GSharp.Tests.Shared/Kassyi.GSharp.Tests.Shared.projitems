<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>3b5eb789-2997-40b9-b8d4-59e35560b411</SharedGUID>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs" Exclude="$(MSBuildThisFileDirectory)Generator\Snapshots\**\*.cs;$(MSBuildThisFileDirectory)**\*.verified.cs;$(MSBuildThisFileDirectory)**\*.received.cs;$(MSBuildThisFileDirectory)TestCases\**\*.cs;$(MSBuildThisFileDirectory)Transpiler\GpuMacroTranspilerRuleKernels.cu.cs;$(MSBuildThisFileDirectory)Transpiler\MacroTranspilerKernels.cu.cs;$(MSBuildThisFileDirectory)Transpiler\MemoryExtensionsTranspilerRuleKernels.cu.cs;$(MSBuildThisFileDirectory)obj\**\*.cs;$(MSBuildThisFileDirectory)bin\**\*.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)TestCases\**\*.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Transpiler\GpuMacroTranspilerRuleKernels.cu.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Transpiler\MacroTranspilerKernels.cu.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Transpiler\MemoryExtensionsTranspilerRuleKernels.cu.cs" />
    <EmbeddedResource
      Include="$(MSBuildThisFileDirectory)Differential\Harness\KnownDivergences.yaml"
      LogicalName="Kassyi.GSharp.Tests.Shared.Differential.KnownDivergences.yaml"
    />
  </ItemGroup>
  <!-- DiffPaths.IsCudaCheckedBuild reads this, so the checked-only CUDA cells run in a GSharpCheckedBuild=true build
       (`just test-checked`). An empty property is written as false: an empty value would drop the constructor
       argument. Items are evaluated after every property, so a default set later in the targets still counts. -->
  <ItemGroup>
    <AssemblyMetadata Include="GSharpCheckedBuild" Value="$(GSharpCheckedBuild)"
      Condition="'$(GSharpCheckedBuild)' != ''" />
    <AssemblyMetadata Include="GSharpCheckedBuild" Value="false" Condition="'$(GSharpCheckedBuild)' == ''" />
  </ItemGroup>
</Project>
