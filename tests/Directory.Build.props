<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)..\.runsettings</RunSettingsFilePath>
    <!-- Suppress compiler warnings from generated test kernel wrappers -->
    <NoWarn>$(NoWarn);0162;8321;8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restore implicit LINQ for test projects since it is removed globally -->
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Kassyi.GSharp.Tests.Common' and '$(IsRoslynComponent)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Kassyi.GSharp.Tests.Common\Kassyi.GSharp.Tests.Common.csproj" />
    <Using Include="Kassyi.GSharp.Tests.Common" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.csv" />
    <None Include="$(MSBuildThisFileDirectory)xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="!Exists('$(MSBuildProjectDirectory)\xunit.runner.json')" />
    <None Include="$(MSBuildProjectDirectory)\xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MSBuildProjectDirectory)\xunit.runner.json')" />
  </ItemGroup>
</Project>
