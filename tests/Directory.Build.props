<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)..\.runsettings</RunSettingsFilePath>
    <!-- Generated wrappers embed each kernel's source as string literals; storing them in a data section
         keeps large suites under the 16 MB user-string heap limit (CS8103) -->
    <Features>$(Features);experimental-data-section-string-literals</Features>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restore implicit LINQ for test projects since it is removed globally -->
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Kassyi.GSharp.Tests.Infrastructure' and '$(IsRoslynComponent)' != 'true' and '$(GSharpTestLibrary)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Shared\Kassyi.GSharp.Tests.Infrastructure\Kassyi.GSharp.Tests.Infrastructure.csproj" />
    <Using Include="Kassyi.GSharp.Tests.Infrastructure" />
    <AssemblyAttribute Include="Xunit.TestCaseOrdererAttribute">
      <_Parameter1>Kassyi.GSharp.Tests.Infrastructure.RandomTestCaseOrderer</_Parameter1>
      <_Parameter2>Kassyi.GSharp.Tests.Infrastructure</_Parameter2>
    </AssemblyAttribute>
    <!-- Test convention analyzers (HNT0002...); severities are set in the tests sections of .editorconfig.
         A project that also uses the analyzer types updates this item with ReferenceOutputAssembly="true". -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)Shared\Kassyi.GSharp.Tests.Generators\Kassyi.GSharp.Tests.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <None Include="$(MSBuildThisFileDirectory)xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="!Exists('$(MSBuildProjectDirectory)\xunit.runner.json')" />
    <None Include="$(MSBuildProjectDirectory)\xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(MSBuildProjectDirectory)\xunit.runner.json')" />
  </ItemGroup>
</Project>
