  "runs": [
    {
      "tool": {
        "driver": {
          "name": "smell-scan",
          "rules": [
            {
              "id": "large-switch",
              "name": "LargeSwitch",
              "shortDescription": {
                "text": "A switch with many sections or arms that is more than a table of one-statement cases."
              },
              "help": {
                "text": "Extract the cases."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "parameters": {
                  "max_cases": 4
                }
              }
            },
            {
              "id": "large-type",
              "name": "TypeSize",
              "shortDescription": {
                "text": "A type that is large in code lines or in members."
              },
              "help": {
                "text": "Split the type."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "parameters": {
                  "max_code_lines": 8,
                  "max_members": 4
                }
              }
            },
            {
              "id": "long-if-chain",
              "name": "LongIfChain",
              "shortDescription": {
                "text": "A chain of if / else if branches that is long."
              },
              "help": {
                "text": "Decompose the conditional."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "parameters": {
                  "max_branches": 5
                }
              }
            },
            {
              "id": "long-string-literal",
              "name": "LongStringLiteral",
              "shortDescription": {
                "text": "A line past the column limit that contains a string literal."
              },
              "help": {
                "text": "Break the literal."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "guidance": "docs/long-lines.md",
                "parameters": {
                  "include_multiline_raw_content": 0,
                  "max_columns": 120
                }
              }
            },
            {
              "id": "swallowed-exception",
              "name": "SwallowedException",
              "shortDescription": {
                "text": "A catch clause that drops the exception without handling it."
              },
              "help": {
                "text": "Do not drop the exception."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "parameters": {}
              }
            }
          ]
        }
      },
