{
  "version": 1,
  "entry": "scripts/human/job-queue.js",
  "stateDir": "tmp/job-queue",
  "sharedRoot": "git-main-checkout",
  "plugins": [
    {
      "name": "./scripts/human/job-queue-henicos",
      "options": {
        "exclusiveCategories": ["Stress", "Benchmark", "GpuTrap"],
        "exclusiveEnv": ["GSHARP_CUDA_TRAP_TESTS"],
        "sharedRecipes": ["test", "test-coverage", "test-differential-cuda"]
      }
    },
    { "name": "dotnet" },
    {
      "name": "just",
      "options": {
        "hookRecipes": "^(test\\S*|coverage-diff|fuzz-\\S+|mutate|long-checks|bench\\S*|doctest)$",
        "hookDryRunRecipes": "^(mutate|long-checks)$"
      }
    },
    { "name": "nvidia-gpu" },
    {
      "name": "agents",
      "options": {
        "sessionEnv": ["CLAUDE_CODE_SESSION_ID", "ANTIGRAVITY_CONVERSATION_ID"],
        "chatStatus": "scripts/human/chat-status.js"
      }
    }
  ],
  "pools": {
    "coresPerSlot": 3,
    "minimumSlots": 2,
    "memoryShare": 0.5,
    "defaultTestMemoryMb": 0
  },
  "resources": {
    "gpu": {
      "slots": 1,
      "probe": {
        "argv": ["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"],
        "min": 3072,
        "timeoutMs": 3000,
        "settleMs": 15000
      },
      "lock": {
        "seats": ["tmp/gpu-test-lock", "tmp/gpu-test-lock-seat1"]
      },
      "holderWatch": ["scripts/human/job-queue/plugins/nvidia-gpu/holder-watch.js"]
    }
  },
  "legacyClients": {
    "testPattern": "\\bdotnet(\\.exe)?\"?\\s+(test|vstest)\\b|\\bjust\\b[^;&|\\n]*?\\s(test[\\w-]*|coverage-diff|mutate|long-checks)(\\s|$)",
    "testMemoryMb": 2880
  }
}
