{
  "job-queue-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/agent/check-queued-command.js --hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "chat-status": {
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/human/chat-status.js --hook",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../scripts/human/chat-status.js --hook",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/human/chat-status.js --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
