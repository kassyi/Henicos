<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime runs a kernel's C# body with the thread context set (GpuExecution, KernelExecution.CSharp), and
         gives the test assemblies the thread context through ManagedThreadContext: an InternalsVisibleTo from Core to
         them would make the internal Fnv1A64, which Core and the compiler both link, ambiguous there -->
    <InternalsVisibleTo Include="Kassyi.GSharp.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the compiler so the shared-memory site keys use the same hash. -->
    <Compile Include="..\..\Shared\Hashing\Fnv1A64.cs" Link="Hashing\Fnv1A64.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Compiler\Kassyi.GSharp.Compiler.Generators\Kassyi.GSharp.Compiler.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" ExcludeAssets="all" SkipGetTargetFrameworkProperties="true" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="..\Kassyi.GSharp.Core.Generators\Kassyi.GSharp.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(IntermediateOutputPath)GeneratedNativeApi\**\*.g.cs" />
    <Compile Remove="**\GeneratedNativeApi\**\*.g.cs" />
  </ItemGroup>

  <Target Name="GenerateNativeApi" BeforeTargets="CoreCompile" Inputs="$(MSBuildThisFileDirectory)..\..\NativeApi\**\*.yml" Outputs="$(IntermediateOutputPath)GeneratedNativeApi.stamp">
    <MakeDir Directories="$(IntermediateOutputPath)GeneratedNativeApi" />
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../../Compiler/Kassyi.GSharp.Compiler.Generators/$(BaseOutputPath)$(Configuration)/net10.0/Kassyi.GSharp.Compiler.Generators.dll&quot; native-api &quot;$(MSBuildThisFileDirectory)../../NativeApi&quot; &quot;$(IntermediateOutputPath)GeneratedNativeApi&quot;" />
    <Touch Files="$(IntermediateOutputPath)GeneratedNativeApi.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeNativeApi" BeforeTargets="CoreCompile" DependsOnTargets="GenerateNativeApi">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GeneratedNativeApi\*Intrinsics.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedNativeApi\*Intrinsics.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedNativeApi.stamp" />
    </ItemGroup>
  </Target>

</Project>
