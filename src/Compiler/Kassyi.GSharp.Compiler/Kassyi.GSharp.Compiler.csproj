<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Compiles the encoder half of the shared GSharpNameEncoding, which writes through SourceWriter. -->
    <DefineConstants>$(DefineConstants);GSHARP_COMPILER</DefineConstants>
    <PolySharpExcludeGeneratedTypes>System.Runtime.CompilerServices.SkipLocalsInitAttribute;System.Runtime.CompilerServices.CallerArgumentExpressionAttribute;System.Runtime.CompilerServices.ModuleInitializerAttribute</PolySharpExcludeGeneratedTypes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests" />
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Cuda" />
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Cpu" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with Runtime so build-time (GSH0057) and runtime key validation use one implementation. -->
    <Compile Include="..\..\Shared\Cryptography\Ed25519Field.cs" Link="Cryptography\Ed25519Field.cs" />
    <Compile Include="..\..\Shared\Cryptography\Ed25519PublicKeyValidator.cs" Link="Cryptography\Ed25519PublicKeyValidator.cs" />
    <!-- Shared with the build tasks, which translate nvcc / host compiler output back to C# names. -->
    <Compile Include="..\..\Shared\Naming\GSharpNameEncoding.cs" Link="Naming\GSharpNameEncoding.cs" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kassyi.GSharp.Compiler.Generators\Kassyi.GSharp.Compiler.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" ExcludeAssets="all" SkipGetTargetFrameworkProperties="true" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="..\Kassyi.GSharp.Compiler.Tasks\Kassyi.GSharp.Compiler.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>

    <!-- Pack build targets -->
    <None Include="build\**" Pack="true" PackagePath="build\" />

    <!-- Pack Custom MSBuild Tasks -->
    <None Include="..\Kassyi.GSharp.Compiler.Tasks\$(BaseOutputPath)$(Configuration)\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll" Pack="true" PackagePath="tasks\netstandard2.0\" Visible="false" />

    <!-- Analyzer Output -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- No runtime yaml dependency anymore -->
  </PropertyGroup>

  <ItemGroup>
    <DialectYamlFiles Include="Dialects\**\*.yml" />
    <DialectYamlFiles Include="Dialects\**\*.yaml" />
    <PreludeResourceFiles Include="Resources\Prelude.cu" />
    <PreludeResourceFiles Include="Resources\StackLinq.cuh" />
    <PreludeResourceFiles Include="Resources\Prelude.cpp" />
    <PreludeResourceFiles Include="Resources\Prelude\*.hpp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(IntermediateOutputPath)GeneratedDialects\**\*.g.cs" />
    <Compile Remove="$(IntermediateOutputPath)GeneratedDiagnostics\**\*.g.cs" />
    <Compile Remove="$(IntermediateOutputPath)GeneratedNativeApi\**\*.g.cs" />
    <Compile Remove="$(IntermediateOutputPath)GeneratedPrelude\**\*.g.cs" />
    <Compile Remove="$(IntermediateOutputPath)GeneratedInternalNames\**\*.g.cs" />
    <Compile Remove="**\GeneratedDialects\**\*.g.cs" />
    <Compile Remove="**\GeneratedDiagnostics\**\*.g.cs" />
    <Compile Remove="**\GeneratedNativeApi\**\*.g.cs" />
    <Compile Remove="**\GeneratedPrelude\**\*.g.cs" />
    <Compile Remove="**\GeneratedInternalNames\**\*.g.cs" />
  </ItemGroup>

  <Target Name="GenerateYamlDialects" BeforeTargets="CoreCompile" Inputs="@(DialectYamlFiles)" Outputs="$(IntermediateOutputPath)GeneratedDialects.stamp">
    <MakeDir Directories="$(IntermediateOutputPath)GeneratedDialects" />
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../Kassyi.GSharp.Compiler.Generators/$(BaseOutputPath)$(Configuration)/net10.0/Kassyi.GSharp.Compiler.Generators.dll&quot; dialects &quot;$(MSBuildThisFileDirectory)Dialects&quot; &quot;$(IntermediateOutputPath)GeneratedDialects&quot;" />
    <Touch Files="$(IntermediateOutputPath)GeneratedDialects.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="GenerateDiagnostics" BeforeTargets="CoreCompile" Inputs="$(MSBuildThisFileDirectory)Diagnostics\diagnostics.json;$(MSBuildThisFileDirectory)..\Kassyi.GSharp.Compiler.Generators\$(BaseOutputPath)$(Configuration)\net10.0\Kassyi.GSharp.Compiler.Generators.dll" Outputs="$(IntermediateOutputPath)GeneratedDiagnostics.stamp">
    <MakeDir Directories="$(IntermediateOutputPath)GeneratedDiagnostics" />
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../Kassyi.GSharp.Compiler.Generators/$(BaseOutputPath)$(Configuration)/net10.0/Kassyi.GSharp.Compiler.Generators.dll&quot; diagnostics &quot;$(MSBuildThisFileDirectory)Diagnostics/diagnostics.json&quot; &quot;$(IntermediateOutputPath)GeneratedDiagnostics&quot;" />
    <Touch Files="$(IntermediateOutputPath)GeneratedDiagnostics.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="GeneratePrelude" BeforeTargets="CoreCompile" Inputs="@(PreludeResourceFiles);$(MSBuildThisFileDirectory)..\Kassyi.GSharp.Compiler.Generators\$(BaseOutputPath)$(Configuration)\net10.0\Kassyi.GSharp.Compiler.Generators.dll" Outputs="$(IntermediateOutputPath)GeneratedPrelude.stamp">
    <MakeDir Directories="$(IntermediateOutputPath)GeneratedPrelude" />
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../Kassyi.GSharp.Compiler.Generators/$(BaseOutputPath)$(Configuration)/net10.0/Kassyi.GSharp.Compiler.Generators.dll&quot; prelude &quot;$(MSBuildThisFileDirectory)Resources&quot; &quot;$(IntermediateOutputPath)GeneratedPrelude&quot;" />
    <Touch Files="$(IntermediateOutputPath)GeneratedPrelude.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="GenerateInternalNames" BeforeTargets="CoreCompile" Inputs="$(MSBuildThisFileDirectory)Resources\InternalNames.yml;@(PreludeResourceFiles);$(MSBuildThisFileDirectory)..\..\Core\Kassyi.GSharp.Core\ManagedGpuContext.cs;$(MSBuildThisFileDirectory)..\Kassyi.GSharp.Compiler.Generators\$(BaseOutputPath)$(Configuration)\net10.0\Kassyi.GSharp.Compiler.Generators.dll" Outputs="$(IntermediateOutputPath)GeneratedInternalNames.stamp">
    <MakeDir Directories="$(IntermediateOutputPath)GeneratedInternalNames" />
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../Kassyi.GSharp.Compiler.Generators/$(BaseOutputPath)$(Configuration)/net10.0/Kassyi.GSharp.Compiler.Generators.dll&quot; internal-names &quot;$(MSBuildThisFileDirectory)Resources/InternalNames.yml&quot; &quot;$(MSBuildThisFileDirectory)Resources/Prelude&quot; &quot;$(MSBuildThisFileDirectory)../../Core/Kassyi.GSharp.Core&quot; &quot;$(IntermediateOutputPath)GeneratedInternalNames&quot;" />
    <Touch Files="$(IntermediateOutputPath)GeneratedInternalNames.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeYamlDialects" BeforeTargets="CoreCompile" DependsOnTargets="GenerateYamlDialects;GenerateDiagnostics;GeneratePrelude;GenerateInternalNames">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GeneratedDialects\**\*.g.cs" />
      <Compile Include="$(IntermediateOutputPath)GeneratedDiagnostics\**\*.g.cs" />
      <Compile Include="$(IntermediateOutputPath)GeneratedPrelude\**\*.g.cs" />
      <Compile Include="$(IntermediateOutputPath)GeneratedInternalNames\**\*.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedDialects\**\*.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedDiagnostics\**\*.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedPrelude\**\*.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedInternalNames\**\*.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedDialects.stamp" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedDiagnostics.stamp" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedPrelude.stamp" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedInternalNames.stamp" />
    </ItemGroup>
  </Target>

</Project>
