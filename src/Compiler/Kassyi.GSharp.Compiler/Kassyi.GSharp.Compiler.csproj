<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests" />
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Cuda" />
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Cpu" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kassyi.GSharp.Compiler.Generators\Kassyi.GSharp.Compiler.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Kassyi.GSharp.Compiler.Tasks\Kassyi.GSharp.Compiler.Tasks.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>

    <!-- Pack build targets -->
    <None Include="build\**" Pack="true" PackagePath="build\" />

    <!-- Pack Custom MSBuild Tasks -->
    <None Include="..\Kassyi.GSharp.Compiler.Tasks\bin\$(Configuration)\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll" Pack="true" PackagePath="tasks\netstandard2.0\" Visible="false" />

    <!-- Analyzer Output -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- No runtime yaml dependency anymore -->
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="Dialects\**\*.yml" />
    <EmbeddedResource Include="Resources\Prelude.cu" />
    <EmbeddedResource Include="Resources\Prelude.cpp" />
  </ItemGroup>

</Project>
