<Project>
  <!-- Locate the task assembly -->
  <PropertyGroup>
    <GSharpCompilerTaskAssembly Condition="Exists('$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll')">$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll</GSharpCompilerTaskAssembly>
    <GSharpCompilerTaskAssembly Condition="'$(GSharpCompilerTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\Kassyi.GSharp.Compiler.Tasks\bin\$(Configuration)\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll</GSharpCompilerTaskAssembly>
  </PropertyGroup>

  <!-- Register the tasks out-of-process to avoid MSBuild node locking (MSB3026/MSB3027) -->
  <UsingTask TaskName="Kassyi.GSharp.Compiler.Tasks.CompileCudaToFatbinTask" AssemblyFile="$(GSharpCompilerTaskAssembly)" TaskFactory="TaskHostFactory" />
  <UsingTask TaskName="Kassyi.GSharp.Compiler.Tasks.CompileCppToNativeTask" AssemblyFile="$(GSharpCompilerTaskAssembly)" TaskFactory="TaskHostFactory" />

  <ItemGroup>
    <CompilerVisibleProperty Include="GSharpTargetDialect" />
    <CompilerVisibleProperty Include="GSharpAotEnabled" />
    <CompilerVisibleProperty Include="GSharpEmitSource" />
    <CompilerVisibleProperty Include="IntermediateOutputPath" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
  </ItemGroup>

  <!-- Define the target to compile CUDA sources -->
  <!-- It runs before GetCopyToOutputDirectoryItems so that the newly built fatbins are copied to the output directory -->
  <Target Name="GSharpCompileCuda" AfterTargets="CoreCompile" BeforeTargets="CopyFilesToOutputDirectory"
          Inputs="$(MSBuildAllProjects);@(Compile)"
          Outputs="$(IntermediateOutputPath)GSharpFatbins\_always_run_.marker">
    
    <PropertyGroup>
      <_SafeAssemblyName>$(AssemblyName.Replace('.', '_'))</_SafeAssemblyName>
    </PropertyGroup>
    <ItemGroup>
      <!-- Collect the unified generated .cu file in the intermediate output path -->
      <_GSharpCudaSources Include="$(IntermediateOutputPath)Kassyi.GSharp.Kernels_$(_SafeAssemblyName).g.cu" Condition="Exists('$(IntermediateOutputPath)Kassyi.GSharp.Kernels_$(_SafeAssemblyName).g.cu')" />
    </ItemGroup>
    
    <Message Importance="High" Text="[DEBUG] IntermediateOutputPath: $(IntermediateOutputPath)" />
    <Message Importance="High" Text="[DEBUG] Found Cuda Sources: @(_GSharpCudaSources)" />

    <!-- Run nvcc via the custom task -->
    <CompileCudaToFatbinTask 
        Condition="'@(_GSharpCudaSources)' != '' And '$(GSharpSkipCudaCompilation)' != 'true' And '$(GSHARP_TEST_NO_CUDA)' != '1'"
        CudaSources="@(_GSharpCudaSources)" 
        OutputDirectory="$(IntermediateOutputPath)GSharpFatbins" 
        TargetArchitectures="$(GSharpTargetArchitectures)" >
      <Output TaskParameter="OutputFatbins" ItemName="_GSharpCompiledFatbins" />
    </CompileCudaToFatbinTask>

    <!-- Copy compiled fatbins to output directory as Content -->
    <!-- Copy compiled fatbins to output directory explicitly -->
    <Copy SourceFiles="@(_GSharpCompiledFatbins)" DestinationFolder="$(OutDir)" />
  </Target>

  <Target Name="GSharpCompileCpu" AfterTargets="CoreCompile" BeforeTargets="CopyFilesToOutputDirectory"
          Inputs="$(MSBuildAllProjects);@(Compile)"
          Outputs="$(IntermediateOutputPath)GSharpNativeDlls\_always_run_.marker">
    
    <ItemGroup>
      <!-- Collect the unified generated .cpp file in the intermediate output path -->
      <_GSharpCppSources Include="$(IntermediateOutputPath)Kassyi.GSharp.Kernels_$(_SafeAssemblyName).g.cpp" Condition="Exists('$(IntermediateOutputPath)Kassyi.GSharp.Kernels_$(_SafeAssemblyName).g.cpp')" />
    </ItemGroup>

    <!-- Run MSVC via the custom task -->
    <CompileCppToNativeTask 
        Condition="'@(_GSharpCppSources)' != '' And '$(GSharpSkipCpuCompilation)' != 'true' And '$(GSHARP_TEST_NO_CPU)' != '1'"
        CppSources="@(_GSharpCppSources)" 
        OutputDirectory="$(IntermediateOutputPath)GSharpNativeDlls" 
        GSharpMultiTarget="$(GSharpMultiTarget)" >
      <Output TaskParameter="OutputDlls" ItemName="_GSharpCompiledDlls" />
    </CompileCppToNativeTask>

    <!-- Copy compiled DLLs to output directory as Content -->
    <!-- Copy compiled DLLs to output directory explicitly -->
    <Copy SourceFiles="@(_GSharpCompiledDlls)" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- Export generated files to referencing projects (transitive copy) -->
  <Target Name="GSharpExportToReferencingProjects" BeforeTargets="GetCopyToOutputDirectoryItems">
    <PropertyGroup>
      <_SafeAssemblyName>$(AssemblyName.Replace('.', '_'))</_SafeAssemblyName>
      <_ArchSuffix Condition="'$(GSharpMultiTarget)' == 'true'">_x64</_ArchSuffix>
      <_ArchSuffix Condition="'$(GSharpMultiTarget)' != 'true'"></_ArchSuffix>
    </PropertyGroup>
    <ItemGroup>
      <!-- Export fatbin -->
      <AllItemsFullPathWithTargetPath Include="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)GSharpFatbins\Kassyi.GSharp.Kernels_$(_SafeAssemblyName).fatbin" Condition="Exists('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)GSharpFatbins\Kassyi.GSharp.Kernels_$(_SafeAssemblyName).fatbin')">
        <TargetPath>Kassyi.GSharp.Kernels_$(_SafeAssemblyName).fatbin</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AllItemsFullPathWithTargetPath>
      <!-- Export CPU native DLLs -->
      <AllItemsFullPathWithTargetPath Include="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)GSharpNativeDlls\Kassyi.GSharp.Kernels_$(_SafeAssemblyName)$(_ArchSuffix).dll" Condition="Exists('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)GSharpNativeDlls\Kassyi.GSharp.Kernels_$(_SafeAssemblyName)$(_ArchSuffix).dll')">
        <TargetPath>Kassyi.GSharp.Kernels_$(_SafeAssemblyName)$(_ArchSuffix).dll</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AllItemsFullPathWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
