<Project>
  <!-- Locate the task assembly -->
  <PropertyGroup>
    <GSharpCompilerTaskAssembly Condition="Exists('$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll')">$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll</GSharpCompilerTaskAssembly>
    <GSharpCompilerTaskAssembly Condition="'$(GSharpCompilerTaskAssembly)' == '' and '$(BaseOutputPath)' != ''">$(MSBuildThisFileDirectory)..\..\Kassyi.GSharp.Compiler.Tasks\$(BaseOutputPath)$(Configuration)\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll</GSharpCompilerTaskAssembly>
    <GSharpCompilerTaskAssembly Condition="'$(GSharpCompilerTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\..\Kassyi.GSharp.Compiler.Tasks\bin\$(Configuration)\netstandard2.0\Kassyi.GSharp.Compiler.Tasks.dll</GSharpCompilerTaskAssembly>
  </PropertyGroup>

  <!-- Register the tasks out-of-process to avoid MSBuild node locking (MSB3026/MSB3027) -->
  <UsingTask TaskName="Kassyi.GSharp.Compiler.Tasks.CompileCudaToFatbinTask" AssemblyFile="$(GSharpCompilerTaskAssembly)" TaskFactory="TaskHostFactory" />
  <UsingTask TaskName="Kassyi.GSharp.Compiler.Tasks.CompileCppToNativeTask" AssemblyFile="$(GSharpCompilerTaskAssembly)" TaskFactory="TaskHostFactory" />

  <ItemGroup>
    <CompilerVisibleProperty Include="GSharpTargetDialect" />
    <CompilerVisibleProperty Include="GSharpAotEnabled" />
    <CompilerVisibleProperty Include="GSharpEmitSource" />
    <CompilerVisibleProperty Include="GSharpExportDeviceCode" />
    <CompilerVisibleProperty Include="GSharpAotEncryptionKey" />
    <CompilerVisibleProperty Include="IntermediateOutputPath" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <CompilerVisibleProperty Include="GSharpMockCompilation" />
    <CompilerVisibleProperty Include="GSharpCombinedFatbinName" />
    <!-- Opt-in marker for YAML native API definitions: <AdditionalFiles Include="*.yml" GSharpApi="true" /> -->
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="GSharpApi" />
  </ItemGroup>

  <PropertyGroup>
    <GetCopyToOutputDirectoryItemsDependsOn>
      $(GetCopyToOutputDirectoryItemsDependsOn);
      GSharpAddGeneratedItemsToOutputDirectory
    </GetCopyToOutputDirectoryItemsDependsOn>
  </PropertyGroup>

  <!-- Debug builds are development builds and sign with the default key on purpose. GS0002 stays a warning in Release and pack builds. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);GS0002</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <Target Name="GSharpAddGeneratedItemsToOutputDirectory" DependsOnTargets="GSharpCompileCuda;GSharpCompileCpu" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <!-- For transitive ProjectReference copy -->
      <AllItemsFullPathWithTargetPath Include="@(_GSharpCompiledFatbins->'%(FullPath)')">
        <TargetPath>%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AllItemsFullPathWithTargetPath>
      <AllItemsFullPathWithTargetPath Include="@(_GSharpCompiledDlls->'%(FullPath)')">
        <TargetPath>%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AllItemsFullPathWithTargetPath>
      
      <!-- For self project copy -->
      <ContentWithTargetPath Include="@(_GSharpCompiledFatbins->'%(FullPath)')">
        <TargetPath>%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="@(_GSharpCompiledDlls->'%(FullPath)')">
        <TargetPath>%(Filename)%(Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <!--
    The generator lists the native sources it wrote (one file name per line, relative to the intermediate output path) in
    Kassyi.GSharp.Kernels.artifacts (AotArtifactWriter.ManifestFileName). Only those are compiled, not every .cu / .cpp
    under obj/. A source of an earlier build (the other dialect, an older assembly name) is then missing from FileWrites,
    and IncrementalClean deletes it together with its fatbin or DLL.
  -->
  <Target Name="GSharpReadArtifactManifest">
    <ReadLinesFromFile File="$(IntermediateOutputPath)Kassyi.GSharp.Kernels.artifacts"
                       Condition="Exists('$(IntermediateOutputPath)Kassyi.GSharp.Kernels.artifacts')">
      <Output TaskParameter="Lines" ItemName="_GSharpAotArtifactNames" />
    </ReadLinesFromFile>

    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)Kassyi.GSharp.Kernels.artifacts"
                  Condition="Exists('$(IntermediateOutputPath)Kassyi.GSharp.Kernels.artifacts')" />
      <!-- The symbol file next to each source, read by the demangler -->
      <FileWrites Include="@(_GSharpAotArtifactNames->'$(IntermediateOutputPath)%(Identity).gsym.json')" />
    </ItemGroup>
  </Target>

  <!-- Define the target to compile CUDA sources -->
  <!-- It runs after CoreCompile (so source generators have emitted .cu files) -->
  <Target Name="GSharpCompileCuda" AfterTargets="CoreCompile" DependsOnTargets="GSharpReadArtifactManifest"
          Inputs="$(MSBuildAllProjects);@(Compile)"
          Outputs="$(IntermediateOutputPath)GSharpFatbins\_always_run_.marker">
    
    <ItemGroup>
      <!-- The generated .cu file listed in the manifest -->
      <_GSharpCudaSources Include="@(_GSharpAotArtifactNames->'$(IntermediateOutputPath)%(Identity)')"
                          Condition="'%(_GSharpAotArtifactNames.Extension)' == '.cu'" />
    </ItemGroup>

    <!-- Run nvcc via the custom task -->
    <CompileCudaToFatbinTask 
        Condition="'@(_GSharpCudaSources)' != '' And '$(GSharpSkipCudaCompilation)' != 'true' And ('$(GSHARP_TEST_NO_CUDA)' != '1' Or '$(GSharpMockCompilation)' == 'true')"
        MockCompilation="$(GSharpMockCompilation)"
        CudaSources="@(_GSharpCudaSources)" 
        CombinedFatbinName="$(GSharpCombinedFatbinName)"
        OutputDirectory="$(IntermediateOutputPath)GSharpFatbins" 
        TargetArchitectures="$(GSharpTargetArchitectures)" >
      <Output TaskParameter="OutputFatbins" ItemName="_GSharpCompiledFatbins" />
    </CompileCudaToFatbinTask>

    <!-- Register all native inputs and outputs to FileWrites for MSBuild clean -->
    <ItemGroup>
      <FileWrites Include="@(_GSharpCudaSources);@(_GSharpCompiledFatbins)" />
      <!-- The nvcc command record next to each fatbin (CompileCudaToFatbinTask.CommandFileExtension) -->
      <FileWrites Include="%(_GSharpCompiledFatbins.NvccCommandFile)" Condition="'%(_GSharpCompiledFatbins.NvccCommandFile)' != ''" />
    </ItemGroup>
  </Target>

  <Target Name="GSharpCompileCpu" AfterTargets="CoreCompile" DependsOnTargets="GSharpReadArtifactManifest"
          Inputs="$(MSBuildAllProjects);@(Compile)"
          Outputs="$(IntermediateOutputPath)GSharpNativeDlls\_always_run_.marker">
    
    <ItemGroup>
      <!-- The generated .cpp file listed in the manifest -->
      <_GSharpCppSources Include="@(_GSharpAotArtifactNames->'$(IntermediateOutputPath)%(Identity)')"
                         Condition="'%(_GSharpAotArtifactNames.Extension)' == '.cpp'" />
    </ItemGroup>

    <!-- Run MSVC via the custom task -->
    <CompileCppToNativeTask 
        Condition="'@(_GSharpCppSources)' != '' And '$(GSharpSkipCpuCompilation)' != 'true' And ('$(GSHARP_TEST_NO_CPU)' != '1' Or '$(GSharpMockCompilation)' == 'true')"
        MockCompilation="$(GSharpMockCompilation)"
        CppSources="@(_GSharpCppSources)" 
        OutputDirectory="$(IntermediateOutputPath)GSharpNativeDlls" 
        GSharpMultiTarget="$(GSharpMultiTarget)" >
      <Output TaskParameter="OutputDlls" ItemName="_GSharpCompiledDlls" />
    </CompileCppToNativeTask>

    <!-- Register all native inputs and outputs to FileWrites for MSBuild clean -->
    <ItemGroup>
      <FileWrites Include="@(_GSharpCppSources);@(_GSharpCompiledDlls)" />
    </ItemGroup>
  </Target>
</Project>
