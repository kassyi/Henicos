<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Unused here; Tests.Integration sees the internal polyfills (InternalsVisibleTo), where it would clash with
         System.Runtime's ModuleInitializerAttribute in the memory budget hooks of every test assembly (CS0433) -->
    <_GSharpUnusedPolyfill>System.Runtime.CompilerServices.ModuleInitializerAttribute</_GSharpUnusedPolyfill>
    <PolySharpExcludeGeneratedTypes>$(_GSharpUnusedPolyfill)</PolySharpExcludeGeneratedTypes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.10.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.10.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Shared\Cryptography\Ed25519.cs" Link="Cryptography\Ed25519.cs" />
    <Compile Include="..\..\Shared\Cryptography\Ed25519Field.cs" Link="Cryptography\Ed25519Field.cs" />
    <Compile Include="..\..\Shared\Cryptography\Ed25519PublicKeyValidator.cs" Link="Cryptography\Ed25519PublicKeyValidator.cs" />
    <Compile Include="..\..\Shared\Cryptography\Ed25519PublicKeyStatus.cs" Link="Cryptography\Ed25519PublicKeyStatus.cs" />
    <Compile Include="..\..\Shared\Naming\GSharpNameEncoding.cs" Link="Naming\GSharpNameEncoding.cs" />
    <Compile Include="..\..\Shared\Naming\GlobalNamePath.cs" Link="Naming\GlobalNamePath.cs" />
    <Compile Include="..\..\Shared\Naming\GlobalNameSegment.cs" Link="Naming\GlobalNameSegment.cs" />
    <Compile Include="..\..\Shared\Hashing\Fnv1A64.cs" Link="Hashing\Fnv1A64.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Integration" />
  </ItemGroup>

</Project>
