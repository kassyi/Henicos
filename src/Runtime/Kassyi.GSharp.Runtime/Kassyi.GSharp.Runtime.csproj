<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Kassyi.GSharp.Core\Kassyi.GSharp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Compiler\Kassyi.GSharp.Compiler.Generators\Kassyi.GSharp.Compiler.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" ExcludeAssets="all" SkipGetTargetFrameworkProperties="true" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="..\..\Compiler\Kassyi.GSharp.Compiler\Kassyi.GSharp.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\..\trusted_keys.txt" Link="trusted_keys.txt" />
    <!-- Native API bindings produced by the YAML native API plugin path (NativeApiGenerator). -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\NativeApi\cuda_driver_api.yml" Link="NativeApi\cuda_driver_api.yml" GSharpApi="true" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\NativeApi\cublas_api.yml" Link="NativeApi\cublas_api.yml" GSharpApi="true" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\NativeApi\curand_api.yml" Link="NativeApi\curand_api.yml" GSharpApi="true" />
    <!-- Mirrors build\Kassyi.GSharp.Compiler.targets, which ProjectReference consumers do not import. -->
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="GSharpApi" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Shared\Cryptography\Ed25519.cs" Link="Cryptography\Ed25519.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Cpu" />
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Cuda" />
  </ItemGroup>

</Project>
