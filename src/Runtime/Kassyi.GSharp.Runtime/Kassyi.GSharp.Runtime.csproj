<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Kassyi.GSharp.Core\Kassyi.GSharp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Compiler\Kassyi.GSharp.Compiler.Generators\Kassyi.GSharp.Compiler.Generators.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="..\..\Compiler\Kassyi.GSharp.Compiler\Kassyi.GSharp.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\..\trusted_keys.txt" Link="trusted_keys.txt" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Shared\Cryptography\Ed25519.cs" Link="Cryptography\Ed25519.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Cpu" />
    <InternalsVisibleTo Include="Kassyi.GSharp.Tests.Cuda" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(IntermediateOutputPath)GeneratedNativeApi\**\*.g.cs" />
  </ItemGroup>

  <Target Name="GenerateNativeApi" BeforeTargets="CoreCompile" Inputs="$(MSBuildThisFileDirectory)..\..\NativeApi\**\*.yml" Outputs="$(IntermediateOutputPath)GeneratedNativeApi.stamp">
    <MakeDir Directories="$(IntermediateOutputPath)GeneratedNativeApi" />
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)..\..\Compiler\Kassyi.GSharp.Compiler.Generators\bin\$(Configuration)\net10.0\Kassyi.GSharp.Compiler.Generators.dll&quot; native-api &quot;$(MSBuildThisFileDirectory)..\..\NativeApi&quot; &quot;$(IntermediateOutputPath)GeneratedNativeApi&quot;" />
    <Touch Files="$(IntermediateOutputPath)GeneratedNativeApi.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeNativeApi" BeforeTargets="CoreCompile" DependsOnTargets="GenerateNativeApi">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GeneratedNativeApi\CudaDriverApi.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedNativeApi\CudaDriverApi.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)GeneratedNativeApi.stamp" />
    </ItemGroup>
  </Target>

</Project>
