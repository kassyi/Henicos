<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\Stdlib\Kassyi.GSharp.Stdlib.GpuMath\Kassyi.GSharp.Stdlib.GpuMath.csproj" />
    <ProjectReference Include="..\..\Runtime\Kassyi.GSharp.Runtime\Kassyi.GSharp.Runtime.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GSharpTargetDialect>Cuda</GSharpTargetDialect>
    <GSharpEmitSource>true</GSharpEmitSource>
    <DefineConstants>GSHARP_CUDA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="GSharpTargetDialect" />
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Compiler\Kassyi.GSharp.Compiler\Kassyi.GSharp.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\..\Compiler\Kassyi.GSharp.Compiler.Generators\Kassyi.GSharp.Compiler.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Compiler\Kassyi.GSharp.Compiler.Tasks\Kassyi.GSharp.Compiler.Tasks.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <NativeBenchmarkCudaSources Include="ComputeBenchmarks\Native\*.cu" />
  </ItemGroup>

  <Target Name="CompileNativeBenchmarks" BeforeTargets="GSharpAddGeneratedItemsToOutputDirectory">
    <CompileCudaToFatbinTask
        CudaSources="@(NativeBenchmarkCudaSources)"
        CombinedFatbinName="native_benchmarks.fatbin"
        OutputDirectory="$(IntermediateOutputPath)GSharpFatbins"
        TargetArchitectures="$(GSharpTargetArchitectures)" >
      <Output TaskParameter="OutputFatbins" ItemName="_GSharpCompiledFatbins" />
    </CompileCudaToFatbinTask>
  </Target>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <Import Project="..\..\Compiler\Kassyi.GSharp.Compiler\build\Kassyi.GSharp.Compiler.targets" />
</Project>