<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kassyi.GSharp.Tools.SmellScan</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Shared\Hashing\Fnv1A64.cs" Link="Hashing\Fnv1A64.cs" />
    <None Include="smells.yml" CopyToOutputDirectory="PreserveNewest" />
    <Using Remove="System.Linq" />
    <InternalsVisibleTo Include="Kassyi.GSharp.Tools.SmellScan.Tests" />
  </ItemGroup>
</Project>
