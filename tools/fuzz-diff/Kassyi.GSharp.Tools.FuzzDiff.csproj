<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Kassyi.GSharp.Tools.FuzzDiff</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Kassyi.GSharp.Core\Kassyi.GSharp.Core.csproj" />
    <ProjectReference Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\Kassyi.GSharp.Compiler.csproj" />
    <None Include="known-issues.yml" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="System" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Text" />
    <Using Include="Kassyi.GSharp.Compiler" />
    <InternalsVisibleTo Include="Kassyi.GSharp.Tools.FuzzDiff.Tests" />
  </ItemGroup>

  <!-- The YAML parser of the compiler (internal there), for known-issues.yml -->
  <ItemGroup>
    <Using Include="System.Collections.Immutable" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\NativeApiReadErrorKind.cs" Link="NativeApi\NativeApiReadErrorKind.cs" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\NativeApiReadError.cs" Link="NativeApi\NativeApiReadError.cs" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\NativeApiReadException.cs" Link="NativeApi\NativeApiReadException.cs" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\YamlSubsetParser.cs" Link="NativeApi\YamlSubsetParser.cs" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\YamlNode.cs" Link="NativeApi\YamlNode.cs" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\YamlScalar.cs" Link="NativeApi\YamlScalar.cs" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\YamlSequence.cs" Link="NativeApi\YamlSequence.cs" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\YamlMapping.cs" Link="NativeApi\YamlMapping.cs" />
    <Compile Include="..\..\src\Compiler\Kassyi.GSharp.Compiler\NativeApi\YamlInlineParser.cs" Link="NativeApi\YamlInlineParser.cs" />
  </ItemGroup>
</Project>
